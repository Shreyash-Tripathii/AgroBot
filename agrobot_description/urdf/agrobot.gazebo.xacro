<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="agrobot_gazebo" params="is_sim:=true">

    <!-- ========================================== -->
    <!-- Gazebo Visual & Physics Properties         -->
    <!-- ========================================== -->
    <gazebo reference="chassis_link">
      <material>Gazebo/Grey</material>
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="front_left_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="front_right_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="rear_left_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="rear_right_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="lidar_link">
      <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="camera_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="imu_link">
      <material>Gazebo/Red</material>
    </gazebo>

    <!-- ============================================================== -->
    <!-- RPLiDAR Sensor (/scan)                                         -->
    <!-- Configured for ROS 2 Jazzy (Gazebo Harmonic gpu_lidar)         -->
    <!-- ============================================================== -->
    <gazebo reference="lidar_link">
      <sensor name="rplidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10.0</update_rate>
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <!-- Fallback plugin for Gazebo Classic -->
        <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================== -->
    <!-- Monocular Camera Sensor (/image_raw, /camera_info)             -->
    <!-- Configured for ROS 2 Jazzy (Gazebo Harmonic camera)            -->
    <!-- ============================================================== -->
    <gazebo reference="camera_link">
      <sensor name="camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>/image_raw</topic>
        <update_rate>30.0</update_rate>
        <gz_frame_id>camera_optical_link</gz_frame_id>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera name="monocular_camera">
          <horizontal_fov>1.085595</horizontal_fov> <!-- ~62.2 degrees horizontal FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <!-- Fallback plugin for Gazebo Classic -->
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>~/image_raw:=/image_raw</remapping>
            <remapping>~/camera_info:=/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_optical_link</frame_name>
          <hack_baseline>0.07</hack_baseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================== -->
    <!-- BNO085 IMU Sensor (/imu/data)                                  -->
    <!-- Configured for ROS 2 Jazzy: 100 Hz Game Rotation & Gravity     -->
    <!-- ============================================================== -->
    <gazebo reference="imu_link">
      <sensor name="bno085_imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/imu/data</topic>
        <update_rate>100.0</update_rate>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <!-- Fallback plugin for Gazebo Classic -->
        <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <remapping>~/out:=/imu/data</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>imu_link</frame_name>
          <update_rate>100.0</update_rate>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================== -->
    <!-- ros2_control Gazebo Plugin                                     -->
    <!-- ROS 2 Jazzy uses gz_ros2_control-system (Gazebo Harmonic)       -->
    <!-- ============================================================== -->
    <xacro:if value="${is_sim}">
      <gazebo>
        <!-- ROS 2 Jazzy Gazebo Harmonic Plugin -->
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find agrobot_bringup)/config/controllers.yaml</parameters>
        </plugin>

        <!-- Fallback for Classic Gazebo -->
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>$(find agrobot_bringup)/config/controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
