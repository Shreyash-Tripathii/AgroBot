# AgroBot telemetry: one RViz window for map, sensors, camera, arm and MoveIt planning.
# Fixed frame 'odom' always exists (EKF); map-frame data appears once SLAM/AMCL publishes map->odom.
# Interact tool + MotionPlanning display = drag the camera (end effector) marker to plan.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Robot1
    - /Sensors1
    - /Navigation1
    - /Arm (MoveIt)1
    Splitter Ratio: 0.5
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 40
    Color: 160; 160; 164
    Alpha: 0.4
  - Class: rviz_common/Group
    Name: Robot
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 1
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
      Show Names: false
      Show Axes: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Odometry
      Name: EKF odometry (/odometry/filtered)
      Enabled: true
      Value: true
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.2
        Shaft Radius: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry
      Enabled: false
      Value: false
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 25; 160; 255
        Alpha: 1
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.2
        Shaft Radius: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agrobot_base_controller/odom
    - Class: rviz_default_plugins/Odometry
      Name: GPS odometry (gps mode)
      Enabled: false
      Value: false
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 25; 255; 120
        Alpha: 1
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.2
        Shaft Radius: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/gps
    - Class: rviz_default_plugins/Odometry
      Name: Global EKF (gps mode)
      Enabled: false
      Value: false
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 255; 200; 25
        Alpha: 1
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.2
        Shaft Radius: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/global
  - Class: rviz_common/Group
    Name: Sensors
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan, arm masked)
      Enabled: true
      Value: true
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Style: Flat Squares
      Size (m): 0.04
      Use Fixed Frame: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan raw (/scan_raw)
      Enabled: false
      Value: false
      Color: 255; 120; 0
      Color Transformer: FlatColor
      Style: Flat Squares
      Size (m): 0.04
      Use Fixed Frame: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_raw
    - Class: rviz_default_plugins/Image
      Name: Arm camera
      Enabled: true
      Value: true
      Normalize Range: true
      Median window: 5
      Min Value: 0
      Max Value: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
  - Class: rviz_common/Group
    Name: Navigation
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Value: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Value: true
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: false
      Value: false
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Use Timestamp: false
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Value: true
      Color: 25; 255; 0
      Alpha: 1
      Line Style: Lines
      Buffer Length: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Value: true
      Color: 255; 0; 255
      Alpha: 1
      Line Style: Lines
      Buffer Length: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Value: true
      Color: 25; 255; 0
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Shape: Arrow (Flat)
      Arrow Length: 0.15
      Alpha: 1
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose
      Enabled: false
      Value: false
      Color: 204; 51; 204
      Alpha: 1
      Covariance:
        Value: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amcl_pose
  - Class: rviz_common/Group
    Name: Arm (MoveIt)
    Enabled: true
    Displays:
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Value: true
      Robot Description: robot_description
      Planning Scene Topic: monitored_planning_scene
      Planning Request:
        Planning Group: arm
        Query Start State: false
        Query Goal State: true
        Interactive Marker Size: 0.12
      Planned Path:
        Trajectory Topic: display_planned_path
        Loop Animation: true
        State Display Time: 0.05 s
        Show Robot Visual: true
        Show Trail: false
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Show Scene Robot: false
        Robot Alpha: 0.5
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.0685
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 7.0
      Pitch: 0.9
      Yaw: 3.9
      Target Frame: base_footprint
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Navigation 2:
    collapsed: false
  Arm camera:
    collapsed: false
  MotionPlanning:
    collapsed: false
  Height: 1000
  Width: 1900
  QMainWindow State: 
