<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agrobot_telemetry</name>
  <version>0.0.0</version>
  <description>One RViz window for AgroBot: map, sensors, arm camera, arm model and MoveIt planning (sim and real robot)</description>
  <maintainer email="shreyash5600@gmail.com">shreyash-tripathi</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>agrobot_moveit_config</exec_depend>
  <exec_depend>agrobot_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
