<?xml version="1.0"?>
<!-- Static primitive model. gz-sim-label-system tags it with label 1; a gz segmentation
     or bounding-box camera pointed at the field then reports it as class 1
     (1 = cabbage, 2 = tomato plant, 3 = carrot) for scoring an OpenCV detector. -->
<sdf version="1.9">
  <model name="cabbage">
    <static>true</static>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>1</label>
    </plugin>
    <link name="link">
      <visual name='head'><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.45 0.72 0.3 1</ambient><diffuse>0.45 0.72 0.3 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <visual name='outer'><pose>0 0 0.08 0 0 0</pose><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>0.2 0.45 0.18 1</ambient><diffuse>0.2 0.45 0.18 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <collision name='c'><pose>0 0 0.12 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.24</length></cylinder></geometry></collision>
    </link>
  </model>
</sdf>
